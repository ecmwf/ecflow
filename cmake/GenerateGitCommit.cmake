#
# Generates a C++ header recording the git commit of the ecFlow sources, shown
# as git(<commit>) in the version description.
#
# Invoked by a custom target at every build (not configure_file), so the commit
# stays current without requiring a CMake reconfigure. The header is rewritten
# only when its content changes, so an unchanged commit triggers no recompilation.
#
# The commit recorded is:
#   - COMMIT, shortened to 12 characters, when given;
#   - otherwise, the first 12 characters of HEAD of SOURCE_DIR, followed by
#     -dirty when tracked files have uncommitted changes;
#   - otherwise (no git, no repository, or git refusing to run), none.
#
# Expected variables (passed via -D on the command line):
#   SOURCE_DIR      root of the ecFlow sources
#   OUTPUT          path to the generated header to write
#   GIT_EXECUTABLE  path to git, optional
#   COMMIT          commit given by the packager, optional
#

if(NOT DEFINED SOURCE_DIR)
  message(FATAL_ERROR "GenerateGitCommit.cmake: SOURCE_DIR is not set")
endif()
if(NOT DEFINED OUTPUT)
  message(FATAL_ERROR "GenerateGitCommit.cmake: OUTPUT is not set")
endif()

set(commit "none")

if(NOT "${COMMIT}" STREQUAL "")
  string(SUBSTRING "${COMMIT}" 0 12 commit)
elseif(GIT_EXECUTABLE AND EXISTS "${SOURCE_DIR}/.git")
  # safe.directory lets git read a tree owned by another user (e.g. mounted in a container);
  # --no-optional-locks keeps git from writing to the repository
  set(git ${GIT_EXECUTABLE} --no-optional-locks -c safe.directory=${SOURCE_DIR} -C ${SOURCE_DIR})

  execute_process(
    COMMAND ${git} rev-parse --verify HEAD
    RESULT_VARIABLE result
    OUTPUT_VARIABLE head
    ERROR_VARIABLE error
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_STRIP_TRAILING_WHITESPACE)

  if(result EQUAL 0 AND head MATCHES "^[0-9a-f]+$")
    string(SUBSTRING "${head}" 0 12 commit)

    execute_process(
      COMMAND ${git} status --porcelain --untracked-files=no
      RESULT_VARIABLE result
      OUTPUT_VARIABLE changes
      ERROR_QUIET)
    if(result EQUAL 0 AND NOT changes STREQUAL "")
      string(APPEND commit "-dirty")
    endif()
  else()
    message(STATUS "GenerateGitCommit.cmake: no git commit found in ${SOURCE_DIR}, recording 'none' (${error})")
  endif()
endif()

set(content "// SPDX-FileCopyrightText: 2009- European Centre for Medium-Range Weather Forecasts (ECMWF)
// SPDX-License-Identifier: Apache-2.0

// Generated by cmake/GenerateGitCommit.cmake. DO NOT EDIT DIRECTLY.

#pragma once

#define ECFLOW_GIT_COMMIT \"${commit}\"
")

if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" current)
endif()
if(NOT "${current}" STREQUAL "${content}")
  file(WRITE "${OUTPUT}" "${content}")
endif()
