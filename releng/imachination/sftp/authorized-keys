# Prints the authorised keys of the user named by the only argument, as sshd's AuthorizedKeysCommand.

case "$1" in
    ''|*[!a-z0-9_-]*) exit 0 ;;
esac

keys="${SFTP_KEYS_DIR:-/workspace/secrets}/$1/authorized_keys"
[ -r "${keys}" ] && cat "${keys}"
exit 0
