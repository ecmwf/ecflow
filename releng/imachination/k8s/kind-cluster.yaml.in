# Template for the `imachination` kind cluster definition.
#
# This file is not usable as it stands: `__WORKSPACE_DIR__` is a placeholder for
# an absolute path, which `imachination.sh` substitutes before creating the
# cluster, writing the result to `.generated/kind-cluster.yaml`. A relative path
# cannot be used, as `extraMounts.hostPath` does not accept one, and the file has
# no way to refer to its own location.
#
# To render and create the cluster by hand, from the `imachination` directory:
#
#   WORKSPACE_DIR="$(cd ecflow/workspace && pwd)"
#   mkdir -p k8s/.generated
#   sed "s|__WORKSPACE_DIR__|${WORKSPACE_DIR}|" \
#       k8s/kind-cluster.yaml.in > k8s/.generated/kind-cluster.yaml
#   kind create cluster --config k8s/.generated/kind-cluster.yaml

kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4

name: imachination

nodes:
  - role: control-plane

    # Host port to node port. The reverse proxy is published as a NodePort
    # service on 30443, which this mapping exposes as the familiar 443 on the
    # host, and the SFTP sidecar of the ecFlow server on 30022, exposed as 2222.
    # These are the whole external surface of the deployment, so there is
    # deliberately nothing here for 80, 8080 or 8888. Those ports remain
    # reachable only from within the cluster.
    extraPortMappings:
      - containerPort: 30443
        hostPort: 443
        listenAddress: "127.0.0.1"
        protocol: TCP
      - containerPort: 30022
        hostPort: 2222
        listenAddress: "127.0.0.1"
        protocol: TCP

    # Host directory to node directory. The ecFlow pod mounts the node path in
    # turn, so that the workspace stays readable and writable on the host.
    extraMounts:
      - hostPath: __WORKSPACE_DIR__
        containerPath: /workspace
