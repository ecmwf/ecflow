{% extends "ci-infrastructure/cmake-atos.sh.j2" %}
{# Aviso support is built against the Aviso client library provisioned by
   releng/buildit/provision_aviso.sh, into the node-local TMPDIR of the job. #}
{% block set_environment %}
AVISO_FFI_ROOT="$(bash "$CI_SOURCE_DIR/releng/buildit/provision_aviso.sh" --dest "${TMPDIR:-/tmp}/aviso-ffi")"
{% endblock %}
{% block preflight %}
{{ super() }}
# Boost and Python come from cluster modules (Boost.Python is linked against a
# specific interpreter); pybind11 still comes from stack-deps.
#
# `boost-root` may be a shell expression, so the gnu leg derives it from the gcc
# actually loaded. A mismatched boost build compiles through and then fails every
# link on std::__throw_bad_array_new_length; fail here with a clear message instead.
boost_root="{{ boost_root }}"
[ -d "$boost_root" ] || {
  echo "no boost build for this toolchain at $boost_root" >&2
  exit 1
}
# The Boost module also exports BOOST_ROOT, which find_package ignores with a CMP0144
# warning; -DBoost_ROOT below already names the same root.
unset BOOST_ROOT

# The test port locks must be shared by every job on the node, but TMPDIR and /tmp
# are private to each job; hence a per-node directory on the shared scratch. Jobs are
# limited to 1 hour, so older lock files are leftovers of killed jobs.
# Where no lock file can be created, every lock attempt fails, and the C++ port search
# never ends.
[ -n "$SCRATCH" ] || {
  echo "SCRATCH is not set, so the test port locks have no shared directory" >&2
  exit 1
}
export ECF_PORT_LOCK_DIR="$SCRATCH/github-ci/ecflow-port-locks/$(hostname -s)"
mkdir -p "$ECF_PORT_LOCK_DIR" &&
  lock_probe=$(mktemp "$ECF_PORT_LOCK_DIR/probe.XXXXXX") &&
  rm -f "$lock_probe" || {
  echo "cannot create lock files in the test port lock directory $ECF_PORT_LOCK_DIR" >&2
  exit 1
}
find "$ECF_PORT_LOCK_DIR" -name '*.lock' -mmin +120 -delete
echo "Using: ECF_PORT_LOCK_DIR=$ECF_PORT_LOCK_DIR"
{% endblock %}
{% block cmake_args %}
  -DENABLE_AVISO=ON \
  -DAVISO_FFI_ROOT="$AVISO_FFI_ROOT" \
  -DBoost_ROOT="$boost_root" \
  -DBoost_INCLUDE_DIR="$boost_root/include" \
  -DPython3_ROOT_DIR={{ python_root }} \
  -DPython3_EXECUTABLE={{ python_root }}/bin/python3 \
{# The python tests otherwise load the system libstdc++, too old for gcc >= 13. #}
{% if pyext_test_ld_library_path | default("") %}
  -DECFLOW_PYEXT_TEST_LD_LIBRARY_PATH={{ pyext_test_ld_library_path }} \
{% endif %}
{% endblock %}
