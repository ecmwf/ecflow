      family check_nrt
        complete ./check_nrt/go eq complete
        edit REFPATH '/mofc/hc2'
        family catchup
          task check_nrt
            event ok
        endfamily
        family rt
          trigger catchup eq complete
          task check_nrt
            event ok
            cron -w 1 06:30
        endfamily
        task go
          complete ./rt/check_nrt:ok or ./catchup/check_nrt:ok
          trigger 0 eq 1
      endfamily
    endfamily
