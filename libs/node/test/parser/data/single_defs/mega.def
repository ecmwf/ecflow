suite dts
  edit USER 'emos'
  edit SCHOST 'c1b'
  edit WSHOST 'swarm'
  edit WSLOGDIR '/vol/emos_nc/output'
  edit SCLOGDIR '/s1b/emos_esuite/emos_data/0014/log'
