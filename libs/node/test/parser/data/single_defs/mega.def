                  task ensms
                    edit LIST_LEV '1000'
                endfamily
                family 500
                  task ensms
                    edit LIST_LEV '500'
                endfamily
              endfamily
              task ensms
                trigger T eq complete and Z eq complete
                edit ENS_MARS 'false'
                inlimit ../limits:fdb
            endfamily
